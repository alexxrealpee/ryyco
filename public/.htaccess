# Hostinger / Apache Environment Variables
<IfModule mod_env.c>
  PassEnv OPENAI_API_KEY
  PassEnv GOOGLE_MAPS_API_KEY
  PassEnv VITE_GOOGLE_MAPS_API_KEY
  # Para configurar tus claves en Hostinger desde este archivo .htaccess, descomenta y pega tus claves:
  # SetEnv OPENAI_API_KEY "sk-proj-tu-clave-aqui"
  # SetEnv GOOGLE_MAPS_API_KEY "AIzaSy-tu-clave-de-google-maps"
  # SetEnv VITE_GOOGLE_MAPS_API_KEY "AIzaSy-tu-clave-de-google-maps"
</IfModule>

# Hostinger / Apache Single Page Application (SPA) Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Endpoints on Hostinger (PHP Backend Bridge)
  RewriteRule ^api/maps/config/?$ api/maps-config.php [QSA,L]
  RewriteRule ^api/maps/key/?$ api/maps-config.php [QSA,L]
  RewriteRule ^api/maps-config\.php$ api/maps-config.php [QSA,L]
  RewriteRule ^api/maps/geocode/?$ api/maps-geocode.php [QSA,L]
  RewriteRule ^api/maps-geocode\.php$ api/maps-geocode.php [QSA,L]
  RewriteRule ^api/realtime/session/?$ api/realtime-session.php [QSA,L]
  RewriteRule ^api/realtime-session/?$ api/realtime-session.php [QSA,L]
  RewriteRule ^api/realtime/client_secrets/?$ api/realtime-session.php [QSA,L]
  RewriteRule ^api/realtime/client-secrets/?$ api/realtime-session.php [QSA,L]
  RewriteRule ^api/voice-assistant/?$ api/voice-assistant.php [QSA,L]
  RewriteRule ^api/gemini/voice-assistant/?$ api/voice-assistant.php [QSA,L]
  RewriteRule ^api/tts/?$ api/tts.php [QSA,L]
  RewriteRule ^api/gemini/tts/?$ api/tts.php [QSA,L]
  RewriteRule ^api/catalog/available/?$ api/catalog-available.php [QSA,L]
  RewriteRule ^api/catalog/?$ api/catalog-available.php [QSA,L]
  RewriteRule ^api/catalog-available\.php$ api/catalog-available.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteCond %{DOCUMENT_ROOT}/api/index.php -f
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  
  # 2. Serve existing physical files, directories, and symlinks directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 3. Route all other client-side URLs to index.html (React / Vite SPA routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Protect sensitive configuration files from direct HTTP access
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env)|keys.*\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Set correct MIME types for modern web assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# Performance: Enable GZIP / Deflate Compression on Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# Performance: Browser Caching (Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 30 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Security, CORS & Cache headers for SPA
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  # Universal CORS allowance for API requests
  <FilesMatch "\.(php|json)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, HEAD"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Range"
  </FilesMatch>
  # Long-term immutable caching for Vite hashed assets
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Disable caching for index.html so updates are immediate
  <FilesMatch "index\.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
