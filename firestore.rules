rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the request is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Check if the user owns the record
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Check if the authenticated user is an administrator
    function isAdmin() {
      return isAuth() && (
        request.auth.token.email == 'alexxrealpee@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Users collection rules
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Profiles collection rules (Read is public so pages load)
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if isOwner(profileId) || isAdmin();
    }
    
    // Custom Links rules (Read is public, write is author-only)
    match /links/{linkId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid);
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
    
    // Themes rules (Publicly readable, write is owner-only or admin)
    match /themes/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Products rules (Public read, author writes or admin)
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuth() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuth() && ((request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid) || isAdmin());
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Leads Rules (Anyone can submit, author reads/manages)
    match /leads/{leadId} {
      allow create: if true;
      allow read: if isAuth() && (resource.data.userId == request.auth.uid);
      allow delete: if isAuth() && (resource.data.userId == request.auth.uid);
    }
    
    // Analytics & Click tracking collections
    match /analytics/{docId} {
      allow create: if true;
      allow read: if isAuth() && (resource.data.userId == request.auth.uid);
    }
    
    match /clicks/{docId} {
      allow create: if true;
      allow read: if isAuth() && (resource.data.userId == request.auth.uid);
    }
    
    // Orders collection rules (Anyone can create/submit, owner, driver & admin can read/update/delete)
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if true;

      // Real-Time Chat subcollection between Driver and Customer for the active order
      match /chat_messages/{messageId} {
        allow read, create, update: if true;
        allow delete: if isAdmin();
      }
    }

    // Direct collection fallback for order chats: order_chats/{orderId}/messages/{messageId}
    match /order_chats/{orderId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, create, update: if true;
        allow delete: if isAdmin();
      }
    }

    // Driver privileges are independent of editable profile roles.
    function driverAdmin() {
      return isAuth() && (request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') == 'alexxrealpee@gmail.com'));
    }
    function verifiedDriverEmail(email) {
      return isAuth() && request.auth.token.get('email_verified', false) == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com' &&
        request.auth.token.get('email', '').lower() == email.lower();
    }
    function ownsDriver(driverId, data) {
      return isAuth() && (verifiedDriverEmail(data.get('email', '')) ||
        (request.auth.token.firebase.sign_in_provider == 'custom' && request.auth.uid == driverId));
    }
    // Private latest position, never exposed to customers or other drivers.
    match /driver_presence/{driverId} {
      function driver() { return get(/databases/$(database)/documents/drivers/$(driverId)).data; }
      allow read: if driverAdmin();
      allow delete: if driverAdmin() || ownsDriver(driverId, driver());
      allow create, update: if ownsDriver(driverId, driver()) &&
        driver().status == 'approved' && driver().isAvailable == true &&
        request.resource.data.keys().hasOnly(['lat', 'lng', 'accuracy', 'gpsTimestamp', 'updatedAt']) &&
        request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        request.resource.data.accuracy is number && request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 60 &&
        request.resource.data.gpsTimestamp is number &&
        request.resource.data.gpsTimestamp >= request.time.toMillis() - 45000 &&
        request.resource.data.gpsTimestamp <= request.time.toMillis() + 5000 &&
        request.resource.data.updatedAt == request.time;
    }

    match /drivers/{driverId} {
      allow get: if driverAdmin() || (resource != null && ownsDriver(driverId, resource.data)) ||
        (resource == null && isAuth() && request.auth.token.get('email_verified', false) == true &&
         driverId == 'driver_' + request.auth.token.get('email', '').lower().replace('[^a-z0-9]', '_'));
      allow list: if driverAdmin();
      allow create: if verifiedDriverEmail(request.resource.data.email) &&
        driverId == 'driver_' + request.auth.token.email.lower().replace('[^a-z0-9]', '_') &&
        request.resource.data.id == driverId && request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.isAvailable == false && request.resource.data.isOnline == false &&
        request.resource.data.rating == 5 && request.resource.data.ratingCount == 0 &&
        request.resource.data.completedDeliveriesCount == 0 && request.resource.data.totalEarnings == 0 &&
        !('password' in request.resource.data);
      allow update: if !('password' in request.resource.data) && (driverAdmin() ||
        (ownsDriver(driverId, resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'uid', 'password', 'firstName', 'lastName', 'phone', 'address', 'city', 'photoURL',
           'docType', 'docNumber', 'birthDate', 'gender', 'vehicleType', 'vehicleBrand', 'vehiclePlate',
           'hasDeliveryBag', 'vehiclePhotoUrl', 'vehicleOwnershipCardUrl', 'driverLicenseUrl',
           'isAvailable', 'isOnline', 'lastActiveAt', 'updatedAt'
         ]) &&
         (request.resource.data.uid == resource.data.uid ||
          (verifiedDriverEmail(resource.data.email) && request.resource.data.uid == request.auth.uid)) &&
         (resource.data.status == 'approved' ||
          (request.resource.data.isAvailable == false && request.resource.data.isOnline == false))));
      allow delete: if driverAdmin();
    }

    // Driver ratings rules
    match /driver_ratings/{ratingId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Delivery Real-Time Tracking rules (Live Courier Geolocation)
    // Cada domiciliario edita solo su propia ubicación para el pedido asignado
    // Cada cliente consulta el seguimiento de su pedido directamente por su orderId
    // GPS is private to authenticated participants, and inaccessible after the order ends.
    // Legacy non-Auth driver IDs require a trusted migration; public profile fields
    // are not sufficient proof to take ownership of an existing tracking document.
    match /delivery_tracking/{orderId} {
      function trackingOrder() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }
      function orderOpen() {
        return !(trackingOrder().get('status', '') in ['delivered', 'cancelled']) &&
               trackingOrder().get('deliveryStep', '') != 'delivered';
      }
      function verifiedCustomer(data) {
        return isAuth() && (
          (request.auth.token.get('email_verified', false) == true &&
           request.auth.token.get('email', '').lower() != '' &&
           request.auth.token.get('email', '').lower() == data.get('customerEmail', '').lower()) ||
          (request.auth.token.get('phone_number', '') != '' &&
           request.auth.token.get('phone_number', '').replace('[^0-9]', '') == data.get('customerPhone', '').replace('[^0-9]', ''))
        );
      }
      function assignedDriver(data) {
        let driver = data.get('driverId', data.get('deliveryDriverId', ''));
        return isAuth() && driver != '' && get(/databases/$(database)/documents/drivers/$(driver)).data.status == 'approved' && driver == trackingOrder().get('deliveryDriverId', trackingOrder().get('driverId', '')) &&
          (driver == request.auth.uid ||
           get(/databases/$(database)/documents/drivers/$(driver)).data.get('uid', '') == request.auth.uid);
      }
      function validPosition(data) {
        return data.isTrackingActive == false ||
          (data.lat is number && data.lng is number && data.lat >= -90 && data.lat <= 90 &&
           data.lng >= -180 && data.lng <= 180 && data.gpsTimestamp is number);
      }
      allow get: if isAuth() && orderOpen() && (
        (resource == null && (verifiedCustomer(trackingOrder()) || assignedDriver(trackingOrder()))) ||
        (resource != null &&
          (resource.data.get('driverAuthUid', '') == request.auth.uid || verifiedCustomer(resource.data) ||
           (assignedDriver(resource.data) && ownsDriver(resource.data.driverId,
             get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data))))
      );
      allow list: if false;
      allow create: if isAuth() && orderOpen() && assignedDriver(request.resource.data) &&
        request.resource.data.driverAuthUid == request.auth.uid && request.resource.data.orderId == orderId &&
        request.resource.data.serverUpdatedAt == request.time && validPosition(request.resource.data);
      allow update: if isAuth() &&
        (resource.data.get('driverAuthUid', '') == request.auth.uid ||
         (assignedDriver(resource.data) && ownsDriver(resource.data.driverId,
           get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data))) &&
        request.resource.data.driverAuthUid == request.auth.uid &&
        request.resource.data.driverId == resource.data.driverId && request.resource.data.orderId == orderId &&
        (!('driverAuthUid' in resource.data) ||
          (request.resource.data.get('customerEmail', '') == resource.data.get('customerEmail', '') &&
           request.resource.data.get('customerPhone', '') == resource.data.get('customerPhone', ''))) &&
        request.resource.data.serverUpdatedAt == request.time && validPosition(request.resource.data) &&
        (!(resource.data.get('status', '') in ['cancelled', 'delivered']) || request.resource.data.status == resource.data.status) &&
        (request.resource.data.isTrackingActive == false ||
          (orderOpen() && assignedDriver(resource.data) && !(resource.data.get('status', '') in ['cancelled', 'delivered']) &&
           request.resource.data.gpsTimestamp >= resource.data.get('gpsTimestamp', 0)));
      allow delete: if isAdmin();
    }

    // Global System Settings rules (Public read for delivery fees, write is admin-only)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin FCM Tokens collection rules for real-time Push Notifications
    match /admin_fcm_tokens/{tokenId} {
      allow read: if driverAdmin();
      allow create, update: if driverAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow delete: if driverAdmin();
    }

    // Seller FCM Tokens collection rules for Merchant Store Push Notifications
    match /seller_fcm_tokens/{tokenId} {
      allow read: if isAuth() && (driverAdmin() || resource.data.storeOwnerId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.storeOwnerId == request.auth.uid && request.resource.data.sellerUid == request.auth.uid;
      allow update: if isAuth() && resource.data.storeOwnerId == request.auth.uid && request.resource.data.storeOwnerId == request.auth.uid && request.resource.data.sellerUid == request.auth.uid;
      allow delete: if isAuth() && (driverAdmin() || resource.data.storeOwnerId == request.auth.uid);
    }

    // Driver FCM Tokens collection rules for Delivery Driver Push Notifications
    match /driver_fcm_tokens/{tokenId} {
      function tokenOwner(data) {
        return ownsDriver(data.driverId, get(/databases/$(database)/documents/drivers/$(data.driverId)).data);
      }
      allow read: if driverAdmin() || tokenOwner(resource.data);
      allow create: if tokenOwner(request.resource.data);
      allow update: if tokenOwner(resource.data) && tokenOwner(request.resource.data) &&
        request.resource.data.driverId == resource.data.driverId;
      allow delete: if driverAdmin() || tokenOwner(resource.data);
    }

    // Subscription payments collection rules (Merchants create and read theirs, administrators approve/reject)
    match /subscription_payments/{paymentId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow update, delete: if isAuth() && isAdmin();
    }

    // Content Creators collection rules (Public read for referral lookups & clicks, write management)
    match /creators/{creatorId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Referral Commissions collection rules
    match /referral_commissions/{commissionId} {
      allow read, create, update, delete: if true;
    }

    // Customers collection rules (Customers look up their RYYCOS, account & roulette spins by phone)
    match /customers/{customerId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // RYYCOS transaction audit logs
    match /ryyco_transactions/{transactionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Store Recommendations rules (❤️ recommendation system)
    // Allows public read for all recommendations & stats
    // Protects against duplicates by enforcing docId == storeId + '_' + userId
    match /recommendations/{recId} {
      allow read: if true;
      allow create, update: if request.resource.data.storeId is string &&
                              request.resource.data.userId is string &&
                              request.resource.data.recommended is bool &&
                              recId == request.resource.data.storeId + '_' + request.resource.data.userId;
      allow delete: if true;
    }

    // Product Recommendations rules (❤️ recommendation system for dishes/products)
    // Allows public read for all product recommendations & stats
    // Protects against duplicates by enforcing recId == productId + '_' + userId
    match /product_recommendations/{recId} {
      allow read: if true;
      allow create, update: if request.resource.data.productId is string &&
                              request.resource.data.userId is string &&
                              request.resource.data.recommended is bool &&
                              recId == request.resource.data.productId + '_' + request.resource.data.userId;
      allow delete: if true;
    }
  }
}
