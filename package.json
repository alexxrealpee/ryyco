{
  "name": "ryyco",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-catalog.mjs",
    "prebuild:client": "node scripts/prepare-catalog.mjs",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build",
    "build:web": "vite build",
    "cap:sync": "npm run build:client && npx cap sync android",
    "cap:sync:ios": "npm run build:client && npx cap sync ios",
    "cap:sync:all": "npm run build:client && npx cap sync",
    "cap:assets": "npx @capacitor/assets generate --android",
    "cap:assets:ios": "npx @capacitor/assets generate --ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run": "npm run build:client && npx cap run android",
    "git:pull": "git pull origin main",
    "git:push": "git add . && git commit -m \"sync update from antigravity\" && git push origin main",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^1.29.0",
    "@openai/agents": "^0.16.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/google.maps": "^3.66.2",
    "@types/leaflet": "^1.9.21",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  }
}
