# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional/Required for ChatGPT & OpenAI Voice Assistant (GPT-4o / GPT-4o-mini & OpenAI TTS)
OPENAI_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Optional/Required for Google Maps Platform interactive map and geocoding
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FCM_SERVER_KEY: Firebase Cloud Messaging Server Key (Legacy Server Key o Cloud Messaging API Key)
# Permite la transmisión de alertas PUSH a través de los servidores de Google FCM cuando la aplicación o el navegador Chrome están cerrados en segundo plano.
FCM_SERVER_KEY=""
